# Supabase — public browser client
# The anon/publishable key can be used by the frontend and is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — privileged server key
# Never expose this in client components, public routes, logs, screenshots or GitHub.
# Use only for trusted server-side maintenance tasks after explicit authorization checks.
SUPABASE_SERVICE_ROLE_KEY=

# Data mode
# local = localStorage MVP fallback
# supabase = use Supabase-backed repositories as modules are migrated
NEXT_PUBLIC_DATA_MODE=local

# OpenAI automation layer — never commit real keys
OPENAI_API_KEY=

# Google Workspace OAuth — configure later
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
